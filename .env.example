# Скопируйте в .env и заполните. Файл .env в git не попадает.
BOT_TOKEN=
BOT_USERNAME=hunters_aibot
# https-адрес Mini App (например https://app.твойдомен.com). Пока пусто, кнопка не показывается.
MINIAPP_URL=
# Публичный адрес сервера ссылок и постбеков
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://hunter:hunter@localhost:5432/hunter
# Секрет для подписи постбеков
POSTBACK_SECRET=change-me
PORT=3000

# Первый админ Hunter Office. Создаётся при запуске, если админов ещё нет.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Секрет для постбеков Pocket Option (не короче 16 символов): openssl rand -hex 16

# Запасные партнёрские ссылки регистрации (для клиентов без стримера)
DEFAULT_PO_LINK=
DEFAULT_PO_LINK_RU=

# Часовой пояс и окно «дневных» пушей (часы начала и конца)
PUSH_TZ=Europe/Kyiv
PUSH_DAY_FROM=10
PUSH_DAY_TO=22

# Копии базы в группу Telegram (по желанию). Скрипт deploy/backup.sh каждую ночь кладёт копию в /var/backups/hunter
# и, если указан BACKUP_TG_CHAT_ID, присылает её файлом через бота. ID группы покажет команда /chatid в группе.
BACKUP_TG_CHAT_ID=
# Номер темы, если в группе включены темы (необязательно)
BACKUP_TG_THREAD_ID=
# Пароль, которым шифруется файл перед отправкой в Telegram (рекомендуется): в базе хэши паролей и реквизиты
BACKUP_PASSPHRASE=

# Сторож сервера (deploy/watchdog.sh) пишет в ту же группу про падение приложения, сайт снаружи, диск, память и копии.
# Если нужна другая группа, укажите её здесь. Порог диска можно менять переменной DISK_WARN в cron.
ALERT_TG_CHAT_ID=
